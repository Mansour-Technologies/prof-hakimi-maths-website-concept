---
import '@fontsource-variable/saira/standard.css';
import '@fontsource-variable/saira/standard-italic.css';
import '@fontsource-variable/newsreader/standard.css';
import '@fontsource-variable/newsreader/standard-italic.css';
import '@fontsource-variable/noto-naskh-arabic/wght.css';
import '@fontsource/covered-by-your-grace/latin-400.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { nav, notice, contact, identity } from '../data/site';
import { url } from '../lib/url';

interface Props { title: string; description: string; home?: boolean }
const { title, description, home = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(url('og.png'), Astro.site).href;
const href = (h: string) => (home ? h : url('') + h);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#130d0b" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_MA" />
    <meta property="og:title" content={`${title} (concept non officiel)`} />
    <meta property="og:description" content={description + ' Concept de démonstration non officiel.'} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Concept de site pour Prof Hakimi maths — démonstration non officielle" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} (concept)`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Aller au contenu</a>
    <p class="notice" role="note" data-demo-notice>{notice}</p>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href={home ? '#top' : url('')} aria-label="Prof Hakimi maths — haut de page">
          <span class="wordmark__p" aria-hidden="true">Prof</span><span class="wordmark__h" aria-hidden="true">Hakimi</span><span class="wordmark__m" aria-hidden="true">maths</span>
        </a>
        <nav class="mainnav" aria-label="Sections de la page">
          <ul>{nav.map((n) => <li><a href={href(n.href)}>{n.label}</a></li>)}</ul>
        </nav>
        <a class="btn btn--ember btn--sm header-cta" href={contact.instagramDM} target="_blank" rel="noopener">Écrire au prof<span class="sr-only"> sur Instagram (nouvel onglet)</span></a>
        <button type="button" class="menu-btn" data-sheet-open aria-haspopup="dialog" aria-controls="sheet" aria-expanded="false"><Icon name="menu" /><span>Menu</span></button>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-id">
          <a class="wordmark wordmark--light" href={home ? '#top' : url('')} aria-label="Prof Hakimi maths — haut de page"><span class="wordmark__p" aria-hidden="true">Prof</span><span class="wordmark__h" aria-hidden="true">Hakimi</span><span class="wordmark__m" aria-hidden="true">maths</span></a>
          <p>Concept de site vitrine pour {identity.fullName} — professeur et chercheur en mathématiques à {identity.city}. 2ᵉ BAC Sciences expérimentales et préparation des concours, au centre Hepta.</p>
          <p class="demo-tag">Démonstration non officielle</p>
        </div>
        <div>
          <h2>Sur cette page</h2>
          <ul>{nav.map((n) => <li><a href={href(n.href)}>{n.label}</a></li>)}</ul>
        </div>
        <div>
          <h2>Ses canaux officiels</h2>
          <ul>
            <li><a href={contact.instagram} rel="noopener" target="_blank">Instagram — {identity.handle}<span class="sr-only"> (nouvel onglet)</span></a></li>
            <li><a href={contact.youtube} rel="noopener" target="_blank">YouTube — Prof Hakimi maths<span class="sr-only"> (nouvel onglet)</span></a></li>
            <li><a href={contact.threads} rel="noopener" target="_blank">Threads — {identity.handle}<span class="sr-only"> (nouvel onglet)</span></a></li>
          </ul>
        </div>
        <div class="footer-legal">
          <p>{notice} Aucune donnée collectée, aucun cookie déposé par ce site. Images des vidéos : servies par YouTube, propriété de leur auteur. Aucune photo hébergée sur ce site.</p>
          <p><a href={contact.studio} rel="noopener" target="_blank">Concept digital proposé par Mansour Technologies.</a></p>
        </div>
      </div>
    </footer>

    <div class="sheet-backdrop" data-sheet-backdrop hidden></div>
    <div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title" hidden>
      <div class="sheet__head">
        <h2 id="sheet-title">Menu</h2>
        <button type="button" class="icon-btn" data-sheet-close aria-label="Fermer le menu"><Icon name="close" /></button>
      </div>
      <p class="sheet__chap" aria-hidden="true">Sommaire :</p>
      <ul>
        {nav.map((n, i) => <li><a href={href(n.href)}><span class="sheet__n">{i + 1})</span>{n.label}</a></li>)}
      </ul>
      <a class="btn btn--ember sheet__cta" href={contact.instagramDM} target="_blank" rel="noopener"><Icon name="ig" /> Écrire au prof<span class="sr-only"> sur Instagram (nouvel onglet)</span></a>
    </div>

    <script>
      import '../scripts/shell';
    </script>
  </body>
</html>
