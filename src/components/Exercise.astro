---
import type { Exercise } from '../data/exercises';
import { difficultyLabel } from '../data/exercises';
import { chapterBySlug } from '../data/chapters';
import { tx, plain } from '../lib/tex';
interface Props { ex: Exercise; index?: number; showChapter?: boolean; headingLevel?: 'h3' | 'h4' }
const { ex, index, showChapter = false, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const ch = chapterBySlug(ex.chapter);
const uid = `ex-${ex.id}`;
---
<article class="ex" data-ex={ex.id} data-type={ex.type} data-chapter={ex.chapter} data-difficulty={ex.difficulty}
  data-answer={ex.type === 'num' ? String(ex.answer) : undefined}
  data-tol={ex.type === 'num' ? String(ex.tolerance) : undefined}
  data-hint={ex.type === 'num' ? ex.hint : 'Revoyez la propriété du cours correspondante.'}
  data-correct={ex.type === 'mcq' ? String(ex.correct) : undefined}
  aria-labelledby={`${uid}-t`}>
  <header class="ex__head">
    <H class="ex__title" id={`${uid}-t`}>
      {index !== undefined && <span class="ex__n">Exercice {index}</span>}
      {ex.group && <span class="ex__group">{ex.group}</span>}
    </H>
    <p class="ex__meta">
      <span class={`diff diff--${ex.difficulty}`}><span class="diff__dots" aria-hidden="true"><i></i><i></i><i></i></span>{difficultyLabel[ex.difficulty]}</span>
      {showChapter && ch && <span>· {ch.fr}</span>}
      <span class="ex__status" aria-hidden="true"></span>
    </p>
  </header>
  <div class="ex__prompt" set:html={tx(ex.prompt)} />
  <form class="ex__form" novalidate>
    {ex.type === 'num' ? (
      <div class="ex__row">
        <label class="sr-only" for={`${uid}-in`}>Votre réponse</label>
        <input class="input ex__input" id={`${uid}-in`} name="answer" inputmode="decimal" autocomplete="off" placeholder="Votre réponse" />
        <button class="btn" type="submit">Vérifier</button>
      </div>
    ) : (
      <fieldset class="ex__mcq">
        <legend class="sr-only">Choisissez une réponse</legend>
        {ex.options.map((o, i) => (
          <label class="opt"><input type="radio" name={`${uid}-q`} value={String(i)} aria-label={plain(o)} /><span set:html={tx(o)} aria-hidden="true" /></label>
        ))}
        <button class="btn" type="submit">Vérifier</button>
      </fieldset>
    )}
    <p class="ex__fb" data-feedback role="status" aria-live="polite"></p>
  </form>
  <details class="ex__sol">
    <summary>Correction détaillée</summary>
    <ol>{ex.steps.map((s) => <li set:html={tx(s)} />)}</ol>
  </details>
  <button type="button" class="ex__reset" data-ex-reset>Recommencer</button>
</article>

<style>
  .ex { position: relative; background: #fff; border: 1px solid var(--rule); border-left: 4px solid var(--rule); padding: 1.25rem clamp(1rem, 0.7rem + 1.5vw, 1.75rem) 1rem; border-radius: 0 var(--radius) var(--radius) 0; }
  .ex[data-state='ok'] { border-left-color: var(--green); }
  .ex[data-state='ko'] { border-left-color: var(--red); }
  .ex__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.3rem 1rem; margin-bottom: 0.6rem; }
  .ex__title { font-family: var(--f-text); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 0.2rem 0.8rem; }
  .ex__group { color: var(--blue); text-transform: none; letter-spacing: 0; font-weight: 600; }
  .ex__meta { margin: 0; font-size: 0.8rem; color: var(--ink-3); display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; }
  .diff { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; color: var(--ink-2); }
  .diff__dots { display: inline-flex; gap: 2px; }
  .diff__dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--grid); }
  .diff--1 .diff__dots i:nth-child(1) { background: var(--green); }
  .diff--2 .diff__dots i:nth-child(-n + 2) { background: var(--orange); }
  .diff--3 .diff__dots i { background: var(--red); }
  .ex__status::before { content: ''; }
  .ex[data-state='ok'] .ex__status::before { content: '✓ réussi'; color: var(--green); font-weight: 700; }
  .ex[data-state='ko'] .ex__status::before { content: '· à revoir'; color: var(--red); font-weight: 700; }
  .ex__prompt { font-size: 1.06rem; line-height: 1.65; overflow-x: auto; }
  .ex__row { display: flex; gap: 0.5rem; margin-top: 0.9rem; }
  .ex__input { max-width: 14rem; font-family: var(--f-math); font-size: 1.1rem; }
  .ex__input[aria-invalid='true'] { border-color: var(--red); }
  .ex__mcq { border: 0; padding: 0; margin: 0.9rem 0 0; display: grid; gap: 0.45rem; }
  .ex__mcq .btn { justify-self: start; margin-top: 0.4rem; }
  .opt { display: flex; align-items: center; gap: 0.7rem; min-height: 48px; padding: 0.45rem 0.8rem; border: 1.5px solid var(--grid); border-radius: var(--radius); cursor: pointer; background: var(--paper); }
  .opt:hover { border-color: var(--rule); }
  .opt:has(input:checked) { border-color: var(--ink); background: #fff; }
  .opt input { width: 1.15rem; height: 1.15rem; accent-color: var(--ink); flex: none; }
  .ex__fb { min-height: 1.5em; margin: 0.7rem 0 0.2rem; font-weight: 600; font-size: 0.95rem; }
  .ex__fb[data-kind='ok'] { color: var(--green); }
  .ex__fb[data-kind='ko'] { color: var(--red); }
  .ex__fb[data-kind='warn'] { color: var(--orange-ink); }
  .ex__sol { border-top: 1px dashed var(--rule); margin-top: 0.4rem; padding-top: 0.6rem; }
  .ex__sol summary { cursor: pointer; font-weight: 600; color: var(--blue); min-height: 40px; display: flex; align-items: center; }
  .ex__sol ol { margin: 0.4rem 0 0.2rem; padding-left: 1.3rem; display: grid; gap: 0.5rem; line-height: 1.7; }
  .ex__sol li::marker { font-family: var(--f-hand); color: var(--red); font-size: 1.2rem; }
  .ex__reset { background: none; border: 0; padding: 0.4rem 0; color: var(--ink-3); font-size: 0.85rem; text-decoration: underline; min-height: 36px; }
  @media (max-width: 420px) { .ex__row { flex-direction: column; } .ex__input { max-width: none; } .ex__row .btn { width: 100%; } }
</style>
