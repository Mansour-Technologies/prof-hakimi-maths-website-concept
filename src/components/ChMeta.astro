---
/** Lightweight JSON index (chapter → checkpoints count, exercise ids, title, first video) for client scripts. */
import { chapters } from '../data/chapters';
import { exercisesFor } from '../data/exercises';
import { videos } from '../data/videos';
const meta = Object.fromEntries(chapters.map((c) => [c.slug, {
  n: c.n, fr: c.fr, checks: c.checkpoints.length, ex: exercisesFor(c.slug).map((e) => e.id),
  video: videos.find((v) => v.topic === c.slug && v.kind === 'cours')?.id ?? videos.find((v) => v.topic === c.slug)?.id ?? null,
}]));
---
<script type="application/json" id="ch-meta" set:html={JSON.stringify(meta)} />
