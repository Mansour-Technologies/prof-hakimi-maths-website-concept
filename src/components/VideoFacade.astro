---
import type { Video } from '../data/videos';
import { fmtDuration } from '../data/videos';
interface Props { video: Video; eager?: boolean; size?: 'lg' | 'md' | 'short' }
const { video, eager = false, size = 'md' } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${video.id}/${size === 'lg' ? 'hqdefault' : 'mqdefault'}.jpg`;
---
<div class={`yt yt--${size}`}>
  <button type="button" class="yt__btn" data-yt={video.id} data-title={video.title}>
    <img src={thumb} alt="" width={size === 'lg' ? 480 : 320} height={size === 'lg' ? 360 : 180} loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" />
    <span class="yt__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
    <span class="yt__dur">{fmtDuration(video.seconds)}</span>
    <span class="sr-only">Lire la vidéo « {video.title} » (lecteur YouTube sans cookies, chargé au clic)</span>
  </button>
</div>

<style is:global>
  .yt { position: relative; aspect-ratio: 16 / 9; background: #000; overflow: hidden; border-radius: 3px; }
  .yt--short { aspect-ratio: 9 / 16; }
  .yt__btn { all: unset; cursor: pointer; position: absolute; inset: 0; display: block; }
  .yt__btn:focus-visible { outline: 3px solid var(--orange); outline-offset: -3px; }
  .yt__btn img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease), opacity 0.3s; opacity: 0.92; }
  .yt__btn:hover img { transform: scale(1.03); opacity: 1; }
  .yt__play { position: absolute; left: 50%; top: 50%; width: 58px; height: 58px; margin: -29px 0 0 -29px; display: grid; place-items: center; border-radius: 50%; background: rgba(17, 25, 21, 0.82); color: #fff; border: 1.5px solid rgba(255, 255, 255, 0.7); transition: transform 0.25s var(--ease), background 0.25s; }
  .yt__play svg { width: 24px; height: 24px; margin-left: 3px; }
  .yt__btn:hover .yt__play { background: var(--red); transform: scale(1.06); }
  .yt__dur { position: absolute; right: 6px; bottom: 6px; background: rgba(0, 0, 0, 0.78); color: #fff; font-size: 0.74rem; font-weight: 600; padding: 2px 6px; border-radius: 3px; font-variant-numeric: tabular-nums; }
  .yt-frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
