---
/**
 * Placeholder for the teacher's OFFICIAL portrait.
 * Replace on approval: drop the authorised photo in /public/portrait.jpg and
 * swap this component's inner figure for an <img>. No photo is rehosted today.
 */
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<figure class:list={['portrait', cls]} data-replace-on-approval="portrait-principal">
  <svg class="portrait__art" viewBox="0 0 400 500" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="pg" width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0V25" fill="none" stroke="rgba(236,238,230,.07)"/></pattern>
    </defs>
    <rect width="400" height="500" fill="#18231e"/>
    <rect width="400" height="500" fill="url(#pg)"/>
    <!-- chalk construction: circle, inscribed triangle, angle -->
    <g fill="none" stroke="rgba(236,238,230,.22)" stroke-width="1.4">
      <circle cx="200" cy="215" r="120"/>
      <path d="M200 95 L304 275 L96 275 Z"/>
      <path d="M200 215 L304 275"/>
      <path d="M232 233 A 36 36 0 0 0 236 205"/>
    </g>
    <text x="200" y="250" text-anchor="middle" font-family="Fraunces Variable, Georgia, serif" font-size="118" font-style="italic" fill="#eceee6" opacity=".9">H</text>
    <circle cx="200" cy="215" r="4" fill="#ff7657"/>
  </svg>
  <figcaption class="portrait__cap">
    <span class="portrait__label">Portrait officiel</span>
    <span>Emplacement réservé à la photo du professeur — intégrée uniquement après son accord.</span>
  </figcaption>
</figure>

<style>
  .portrait { position: relative; margin: 0; aspect-ratio: 4 / 5; border: 1px solid rgba(236, 238, 230, 0.18); background: #18231e; overflow: hidden; }
  .portrait::before { content: ''; position: absolute; inset: 10px; border: 1px dashed rgba(236, 238, 230, 0.22); pointer-events: none; z-index: 1; }
  .portrait__art { width: 100%; height: 100%; object-fit: cover; }
  .portrait__cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 1.1rem 1.2rem 1.2rem; background: linear-gradient(transparent, rgba(10, 15, 12, 0.92) 40%); color: var(--chalk-2); font-size: 0.82rem; line-height: 1.45; display: grid; gap: 0.2rem; z-index: 2; }
  .portrait__label { font-family: var(--f-hand); font-size: 1.35rem; color: var(--chalk-yellow); line-height: 1; }
</style>
