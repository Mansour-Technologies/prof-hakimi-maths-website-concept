---
/** Brand mark: a cubic curve and its tangent touching at a red point (original). */
interface Props { size?: number; class?: string }
const { size = 26, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <path d="M3 25 C 9 25, 10 7, 16 13 S 23 24, 29 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
  <path d="M5 21.5 L 27 4.5" stroke="#f3d46b" stroke-width="1.6" stroke-linecap="round"/>
  <circle cx="16" cy="13" r="3" fill="#ff7657"/>
</svg>
