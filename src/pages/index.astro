---
import Base from '../layouts/Base.astro';
import HeroPlot from '../components/HeroPlot.astro';
import PortraitSlot from '../components/PortraitSlot.astro';
import VideoFacade from '../components/VideoFacade.astro';
import ChapterFigure from '../components/ChapterFigure.astro';
import Icon from '../components/Icon.astro';
import { chapters } from '../data/chapters';
import { videos, fmtDuration } from '../data/videos';
import { identity, contact } from '../data/site';
import { tex } from '../lib/tex';

const v = (id: string) => videos.find((x) => x.id === id)!;
const featured = v('yg6YlI4Rz9c');
const side = [v('6XTA_EX9w2Y'), v('wM88JcxD2ao')];
const shorts = [v('K57PPKXKBHs'), v('n8D5n4ufnp4'), v('xxG1hjN4r1c'), v('L93mPstfJBA')];

const approach = [
  {
    t: 'Le cours complet, au tableau', fig: 'complex' as const,
    p: 'Des leçons longues, tracées au feutre de bout en bout : définitions, propriétés, démonstrations et exemples, sans couper les étapes.',
    ex: 'Nombres complexes — partie 1, 1 h 23 ; Calcul intégral — partie 1, 1 h 07.',
  },
  {
    t: 'La correction qui montre la méthode', fig: 'limit' as const,
    p: 'Des exercices du manuel « Al Moufid » et des sujets d’examen corrigés pas à pas, pour apprendre à rédiger autant qu’à calculer.',
    ex: 'Exercice 32 — dérivabilité de la fonction réciproque ; correction d’un examen sur la continuité, le TVI et la fonction réciproque (2 BAC PC).',
  },
  {
    t: 'La capsule qui va à l’essentiel', fig: 'sym' as const,
    p: 'Une idée, une minute : un résultat du cours isolé et expliqué, à revoir juste avant un contrôle.',
    ex: '« Limite et nombre dérivé », « Axe de symétrie d’une courbe », « Les suites numériques (suite majorée) ».',
  },
  {
    t: 'L’état d’esprit, et la culture autour', fig: 'cobweb' as const,
    p: 'Des messages pour tenir jusqu’au BAC, et des ouvertures sur l’histoire et la philosophie des mathématiques.',
    ex: 'Évariste Galois, le « nombre phénix », « les mathématiques : invention ou découverte ? ».',
  },
];

type Ch = { href: string; label: string; sub: string; icon: 'ig' | 'yt' | 'threads' | 'phone'; primary: boolean };
const channels: Ch[] = [
  { href: contact.instagramDM, label: 'Écrire en message privé', sub: `Instagram · ${identity.handle}`, icon: 'ig', primary: true },
  ...(contact.whatsapp ? [{ href: contact.whatsapp, label: 'WhatsApp', sub: 'Numéro communiqué par le professeur', icon: 'phone' as const, primary: false }] : []),
  { href: contact.youtube, label: 'Chaîne YouTube', sub: 'YouTube · @prof_hakimi_maths', icon: 'yt', primary: false },
  { href: contact.instagram, label: 'Profil Instagram', sub: 'Instagram · @prof_hakimi_maths', icon: 'ig', primary: false },
  { href: contact.threads, label: 'Threads', sub: 'Threads · @prof_hakimi_maths', icon: 'threads', primary: false },
];
---
<Base title="Prof Hakimi maths — Hicham Hakimi, professeur de mathématiques" description="Concept de site vitrine pour Prof Hakimi maths (Hicham Hakimi) : professeur et chercheur en mathématiques, 2ᵉ BAC Sciences expérimentales et préparation des concours.">
  <!-- ——— HERO ——— -->
  <section class="hero board" id="top" aria-labelledby="hero-title">
    <HeroPlot />
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="kicker"><span class="dot"></span><span class="dot dot--o"></span><span class="dot dot--g"></span><span class="dot dot--w"></span> {identity.handle}</p>
        <h1 id="hero-title" class="hero__name">
          <span class="hero__first">Hicham</span>
          <span class="hero__last">Hakimi</span>
        </h1>
        <p class="hero__role">Professeur &amp; chercheur en mathématiques — <span class="nowrap">2ᵉ BAC Sciences expérimentales</span>, préparation des concours.</p>
        <p class="hero__lead">Les mathématiques comme on les fait au tableau&nbsp;: une définition, une figure juste, puis chaque étape jusqu’au résultat.</p>
        <div class="hero__cta">
          <a class="btn btn--chalk" href={contact.instagramDM} target="_blank" rel="noopener"><Icon name="ig" /> Écrire au professeur<span class="sr-only"> sur Instagram (nouvel onglet)</span></a>
          <a class="btn btn--ghost" href="#videos">Voir ses cours en vidéo</a>
        </div>
      </div>
      <div class="hero__side">
        <PortraitSlot class="hero__portrait" />
      </div>
    </div>
    <div class="wrap hero__foot">
      <p class="heroplot__eq" aria-hidden="true">
        <span class="heroplot__f">f(x) = x³⁄4 − x</span>
        <span>tangente en x₀ = <b data-x0>1,50</b></span>
        <span>y = <b data-eq>0,69x − 1,69</b></span>
      </p>
      <p class="hero__ar ar" lang="ar">الرياضيات، خطوة بخطوة</p>
    </div>
  </section>

  <!-- ——— FACTS ——— -->
  <section class="facts" aria-label="En bref">
    <div class="wrap facts__row">
      <p><b>2ᵉ BAC</b>Sciences expérimentales — filière PC citée dans ses vidéos</p>
      <p><b>Concours</b>une série dédiée à la préparation des concours post-bac</p>
      <p><b>FR · ع</b>les maths en français, l’explication en arabe et en darija</p>
      <p><b>Au tableau</b>cours complets, corrections d’exercices, capsules courtes</p>
    </div>
  </section>

  <!-- ——— PROFESSEUR ——— -->
  <section class="section paper-grid prof" id="professeur" aria-labelledby="prof-title">
    <div class="wrap prof__grid">
      <div class="reveal">
        <p class="kicker"><span class="dot dot--w"></span> Le professeur</p>
        <h2 id="prof-title" class="prof__h">Rigueur au tableau, <em>culture</em> autour.</h2>
        <figure class="prof__fig">
          <ChapterFigure kind="tangent" label="Une courbe et sa tangente en un point" />
          <figcaption class="hand">la tangente : la meilleure droite au voisinage d’un point</figcaption>
        </figure>
      </div>
      <div class="prof__body reveal">
        <blockquote class="prof__quote">
          <p lang="ar" class="ar">و أنت في طريقك للبحث عن حياة لا تنسى أن تعيش</p>
          <footer>— première ligne de sa biographie Instagram</footer>
        </blockquote>
        <p class="prof__lead">{identity.fullName} se présente comme <strong>professeur de mathématiques</strong> et <strong>chercheur en mathématiques</strong>. Sur sa chaîne, il enseigne le programme du 2ᵉ BAC Sciences expérimentales et partage, à côté du cours, ce qui fait tenir un élève&nbsp;: la méthode, la constance et le goût des idées.</p>
        <dl class="prof__facts">
          <div><dt>Matière</dt><dd>Mathématiques</dd></div>
          <div><dt>Niveaux</dt><dd>2ᵉ BAC Sciences expérimentales (PC) · préparation des concours post-bac</dd></div>
          <div><dt>Langues</dt><dd>Français pour les notions, arabe et darija pour l’explication</dd></div>
          <div><dt>Supports</dt><dd>Tableau blanc, manuel « Al Moufid », sujets d’examen</dd></div>
        </dl>
        <p class="src-note">Informations issues de ses comptes publics Instagram et YouTube (relevé du 26 novembre 2026). Parcours détaillé et diplômes&nbsp;: à compléter avec le professeur.</p>
      </div>
    </div>
  </section>

  <!-- ——— APPROCHE ——— -->
  <section class="section approach" id="approche" aria-labelledby="app-title">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker"><span class="dot"></span> Approche pédagogique</p>
        <h2 id="app-title">Quatre façons d’apprendre<span class="h-ar" lang="ar">طريقة التدريس</span></h2>
        <p>Ce qu’on observe dans ses publications : le même souci de clarté, sous quatre formes.</p>
      </header>
      <ol class="app">
        {approach.map((a, i) => (
          <li class="app__row reveal">
            <span class="app__n" aria-hidden="true">{['I', 'II', 'III', 'IV'][i]}</span>
            <div class="app__body">
              <h3>{a.t}</h3>
              <p>{a.p}</p>
              <p class="app__ex"><span>Exemples publiés</span>{a.ex}</p>
            </div>
            <div class="app__fig"><ChapterFigure kind={a.fig} /></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ——— PROGRAMME ——— -->
  <section class="section board chalk-grid programme" id="programme" aria-labelledby="prog-title">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker"><span class="dot dot--g"></span> Ce qu’il enseigne</p>
        <h2 id="prog-title">Le programme<span class="h-ar" lang="ar">المقرر</span></h2>
        <p>Les chapitres de mathématiques du 2ᵉ BAC Sciences expérimentales qu’il a déjà traités publiquement en vidéo.</p>
      </header>
      <div class="levels reveal">
        <div class="level">
          <p class="level__k">Niveau principal</p>
          <p class="level__t">2ᵉ année Bac<br /><em>Sciences expérimentales</em></p>
          <p class="level__s">Filière PC citée dans ses titres ; corrections du manuel « Al Moufid — sciences expérimentales ».</p>
        </div>
        <div class="level">
          <p class="level__k">Préparation</p>
          <p class="level__t">Concours<br /><em>post-bac</em></p>
          <p class="level__s">Série « Préparation des concours avec Prof Hakimi — Astuce 1 à 5 ».</p>
        </div>
        <div class="level level--muted">
          <p class="level__k">Autres niveaux</p>
          <p class="level__t">À préciser<br /><em>avec le professeur</em></p>
          <p class="level__s">Collège, tronc commun, 1ʳᵉ BAC, autres filières : non mentionnés publiquement.</p>
        </div>
      </div>
      <ol class="toc">
        {chapters.map((c, i) => (
          <li class="toc__row reveal">
            <span class="toc__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="toc__t">{c.fr}<span class="toc__ar" lang="ar">{c.ar}</span></span>
            <span class="toc__f" set:html={tex(c.formula)} />
          </li>
        ))}
      </ol>
      <p class="toc__note">Formules affichées à titre d’illustration du chapitre.</p>
    </div>
  </section>

  <!-- ——— VIDEOS ——— -->
  <section class="section" id="videos" aria-labelledby="vid-title">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker"><span class="dot dot--o"></span> Contenus publics</p>
        <h2 id="vid-title">Au tableau<span class="h-ar" lang="ar">الدروس بالفيديو</span></h2>
        <p>Une sélection de sa chaîne YouTube. Le lecteur (sans cookies) ne se charge que lorsque vous appuyez sur lecture.</p>
      </header>
      <div class="vids">
        <article class="vids__main reveal">
          <VideoFacade video={featured} size="lg" />
          <p class="vids__k">Cours complet · {fmtDuration(featured.seconds)}</p>
          <h3 class="vids__t">Les nombres complexes — partie 1 <span class="h-ar" lang="ar">الأعداد العقدية</span></h3>
        </article>
        <div class="vids__side">
          {side.map((s) => (
            <article class="vids__item reveal">
              <VideoFacade video={s} />
              <p class="vids__k">{s.id === '6XTA_EX9w2Y' ? 'Cours' : 'Correction d’examen'} · {fmtDuration(s.seconds)}</p>
              <h3 class="vids__t vids__t--sm">{s.id === '6XTA_EX9w2Y' ? 'Calcul intégral — partie 1' : 'Continuité, TVI, fonction réciproque — 2 BAC PC'}</h3>
            </article>
          ))}
        </div>
      </div>
      <h3 class="rail-title">Capsules</h3>
      <ul class="rail" aria-label="Capsules courtes du professeur">
        {shorts.map((s) => (
          <li class="rail__item">
            <VideoFacade video={s} size="short" />
            <p class="rail__t mixed" dir="auto">{s.title.replace(/#\S+/g, '').trim()}</p>
          </li>
        ))}
      </ul>
      <p class="vids__more"><a class="btn btn--ghost" href={contact.youtube} target="_blank" rel="noopener"><Icon name="yt" /> Toutes ses vidéos sur YouTube<span class="sr-only"> (nouvel onglet)</span></a></p>
    </div>
  </section>

  <!-- ——— ÉTUDIER ——— -->
  <section class="section board study" id="etudier" aria-labelledby="study-title">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker"><span class="dot"></span> Étudier avec lui</p>
        <h2 id="study-title">Trois termes d’une <em>suite</em></h2>
        <p>Le chemin le plus simple, à partir des canaux qu’il utilise déjà.</p>
      </header>
      <ol class="steps">
        <li class="step reveal">
          <span class="step__u" set:html={tex('u_0')} />
          <h3>Découvrir sa façon d’expliquer</h3>
          <p>Commencez par ses cours et capsules gratuits sur YouTube et Instagram&nbsp;: vous saurez vite si son approche vous convient.</p>
        </li>
        <li class="step reveal">
          <span class="step__u" set:html={tex('u_1')} />
          <h3>Lui écrire en message privé</h3>
          <p>Sur Instagram, présentez-vous en une phrase&nbsp;: niveau, filière, chapitre qui bloque, objectif (examen national, concours).</p>
        </li>
        <li class="step reveal">
          <span class="step__u" set:html={tex('u_2')} />
          <h3>Convenir des modalités avec lui</h3>
          <p>Format, horaires et conditions vous sont communiqués directement par le professeur — ils ne sont pas publiés en ligne.</p>
        </li>
      </ol>
      <div class="study__lim reveal">
        <span class="study__tex" set:html={tex('\\lim_{n\\to+\\infty} u_n = \\text{le BAC}')} />
        <a class="btn btn--chalk" href={contact.instagramDM} target="_blank" rel="noopener"><Icon name="ig" /> Envoyer un message<span class="sr-only"> sur Instagram (nouvel onglet)</span></a>
      </div>
    </div>
  </section>

  <!-- ——— CONTACT ——— -->
  <section class="section paper-grid contact" id="contact" aria-labelledby="contact-title">
    <div class="wrap contact__grid">
      <div class="reveal">
        <p class="kicker"><span class="dot dot--g"></span> Contact</p>
        <h2 id="contact-title" class="contact__h">Une question&nbsp;?<br /><em>Écrivez-lui.</em></h2>
        <p class="contact__p">Le message privé Instagram est aujourd’hui le moyen le plus direct de joindre le professeur.</p>
      </div>
      <ul class="channels reveal">
        {channels.map((c) => (
          <li>
            <a class:list={['channel', { 'channel--primary': c.primary }]} href={c.href} target="_blank" rel="noopener">
              <span class="channel__i"><Icon name={c.icon === 'phone' ? 'ig' : c.icon} /></span>
              <span class="channel__txt"><b>{c.label}</b><span>{c.sub}</span></span>
              <span class="channel__arrow"><Icon name="arrow" /></span>
              <span class="sr-only"> (nouvel onglet)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; isolation: isolate; padding-block: clamp(2.2rem, 1.5rem + 4vw, 5rem) 1.6rem; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; background: linear-gradient(90deg, rgba(17, 25, 21, 0.92) 0%, rgba(17, 25, 21, 0.55) 42%, rgba(17, 25, 21, 0) 70%); }
  .hero__grid { position: relative; z-index: 2; display: grid; gap: 2rem; align-items: end; }
  .hero__grid > * { min-width: 0; }
  @media (min-width: 900px) { .hero__grid { grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.75fr); gap: 4rem; min-height: min(72vh, 640px); } }
  .hero__name { font-weight: 400; font-size: clamp(3.6rem, 1.6rem + 9vw, 9.2rem); line-height: 0.88; letter-spacing: -0.035em; margin: 1rem 0 1.2rem; font-variation-settings: 'opsz' 144; }
  .hero__name span { display: block; }
  .hero__last { font-style: italic; color: var(--chalk-yellow); padding-left: 0.42em; }
  .hero__role { font-size: var(--step-1); color: var(--chalk); max-width: 34rem; margin-bottom: 0.8rem; font-weight: 500; }
  .hero__lead { font-size: var(--step-0); color: var(--chalk-2); max-width: 32rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.6rem; }
  .hero__side { align-self: center; }
  .hero__portrait { max-width: 380px; margin-left: auto; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.8); }
  .hero__foot { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-top: 2.2rem; padding-top: 1rem; border-top: 1px solid rgba(236, 238, 230, 0.12); }
  .hero__ar { margin: 0; font-size: 1.35rem; color: var(--chalk-2); }
  .nowrap { white-space: nowrap; }
  .heroplot__eq { position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: 0.25rem 1.2rem; margin: 0; font-family: var(--f-math); font-size: 1.05rem; color: var(--chalk-2); }
  .heroplot__eq b { font-weight: 400; color: var(--chalk-yellow); font-variant-numeric: tabular-nums; }
  .heroplot__f { color: var(--chalk); font-style: italic; }
  @media (max-width: 899px) {
    .hero::after { background: linear-gradient(180deg, rgba(17, 25, 21, 0.15), rgba(17, 25, 21, 0.55) 30%, rgba(17, 25, 21, 0.92) 50%, rgba(17, 25, 21, 0.98)); }
    .hero__portrait { max-width: none; aspect-ratio: 4 / 4.2; margin: 0; }
    .hero__cta .btn { flex: 1 1 100%; }
    .hero__foot { flex-direction: column; align-items: flex-start; }
  }

  /* FACTS */
  .facts { background: var(--board-2); color: var(--chalk-2); border-top: 1px solid var(--board-3); }
  .facts__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .facts__row { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .facts p { margin: 0; padding: 1.3rem 1rem; font-size: 0.86rem; line-height: 1.4; border-right: 1px solid var(--board-3); }
  .facts p:first-child { padding-left: 0; }
  .facts p:last-child { border-right: 0; }
  @media (max-width: 899px) { .facts p { border-bottom: 1px solid var(--board-3); } .facts p:nth-child(odd) { padding-left: 0; } .facts p:nth-child(even) { border-right: 0; } }
  .facts b { display: block; font-family: var(--f-display); font-weight: 500; font-size: 1.6rem; color: var(--chalk); margin-bottom: 0.2rem; }

  /* PROFESSEUR */
  .prof__grid { display: grid; gap: 2.5rem; }
  .prof__grid > * { min-width: 0; }
  @media (min-width: 960px) { .prof__grid { grid-template-columns: 1fr 1.2fr; gap: 5rem; } }
  .prof__h { font-size: var(--step-4); margin-top: 0.8rem; }
  .prof__h em { color: var(--red); }
  .prof__fig { margin: 2.5rem 0 0; max-width: 420px; }
  .prof__fig figcaption { color: var(--red); font-size: 1.35rem; margin-top: 0.4rem; }
  .prof__quote { margin: 0 0 1.8rem; padding: 0 0 1.5rem; border-bottom: 1px solid var(--rule); }
  .prof__quote p { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.2rem); line-height: 1.7; margin: 0 0 0.3rem; }
  .prof__quote footer { font-size: 0.85rem; color: var(--ink-3); }
  .prof__lead { font-size: var(--step-1); line-height: 1.6; }
  .prof__facts { margin: 1.8rem 0 0; display: grid; border-top: 2px solid var(--ink); }
  .prof__facts div { display: grid; gap: 0.2rem; padding: 0.9rem 0; border-bottom: 1px solid var(--rule); }
  @media (min-width: 600px) { .prof__facts div { grid-template-columns: 9rem 1fr; gap: 1rem; } }
  .prof__facts dt { font-size: 0.76rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; color: var(--ink-3); padding-top: 0.2rem; }
  .prof__facts dd { margin: 0; }
  .src-note { font-size: 0.82rem; color: var(--ink-3); margin-top: 1.2rem; }

  /* APPROCHE */
  .app { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .app__row { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: 0.5rem 1.2rem; padding: 2rem 0; border-bottom: 1px solid var(--rule); }
  @media (min-width: 900px) { .app__row { grid-template-columns: 6rem minmax(0, 1fr) 300px; gap: 2.5rem; align-items: center; padding: 2.6rem 0; } }
  .app__n { font-family: var(--f-display); font-style: italic; font-size: clamp(2rem, 1.5rem + 2vw, 3.4rem); color: var(--red); line-height: 1; }
  .app__body h3 { font-size: var(--step-2); margin-bottom: 0.6rem; }
  .app__body p { color: var(--ink-2); max-width: 40rem; }
  .app__ex { font-size: 0.92rem; margin: 0; }
  .app__ex span { display: block; font-family: var(--f-hand); font-size: 1.25rem; color: var(--blue); font-weight: 600; line-height: 1.1; }
  .app__fig { grid-column: 2; max-width: 300px; }
  @media (min-width: 900px) { .app__fig { grid-column: auto; } }
  @media (max-width: 599px) { .app__fig { display: none; } }

  /* PROGRAMME */
  .levels { display: grid; gap: 1px; background: var(--board-3); border: 1px solid var(--board-3); margin-bottom: 3rem; }
  @media (min-width: 900px) { .levels { grid-template-columns: 1.2fr 1fr 1fr; } }
  .level { background: var(--board); padding: 1.5rem; }
  .level__k { font-size: 0.76rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; color: var(--chalk-3); margin-bottom: 0.6rem; }
  .level__t { font-family: var(--f-display); font-size: var(--step-2); line-height: 1.1; color: var(--chalk); margin-bottom: 0.8rem; }
  .level__t em { color: var(--chalk-yellow); }
  .level__s { font-size: 0.9rem; color: var(--chalk-2); margin: 0; }
  .level--muted .level__t, .level--muted .level__t em { color: var(--chalk-2); }
  .toc { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--chalk); }
  .toc__row { display: grid; grid-template-columns: 2.6rem minmax(0, 1fr); gap: 0.3rem 1rem; padding: 1.15rem 0; border-bottom: 1px solid var(--board-3); align-items: baseline; }
  @media (min-width: 900px) { .toc__row { grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; } }
  .toc__n { font-family: var(--f-display); font-style: italic; font-size: 1.5rem; color: var(--red-hi); }
