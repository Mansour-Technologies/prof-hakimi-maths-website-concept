---
import Base from '../../layouts/Base.astro';
import ChapterFigure from '../../components/ChapterFigure.astro';
import Icon from '../../components/Icon.astro';
import ChMeta from '../../components/ChMeta.astro';
import { chapters } from '../../data/chapters';
import { videos, collections } from '../../data/videos';
import { exercisesFor } from '../../data/exercises';
import { url } from '../../lib/url';

const vids = (slug: string) => videos.filter((v) => v.topic === slug).length;
---
<Base title="Chapitres du programme" active="cours/" description="Tous les chapitres de mathématiques du 2ᵉ BAC Sciences expérimentales, avec filtres, recherche, vidéos de Prof Hakimi et suivi de progression (démo).">
  <section class="page-hero board chalk-grid">
    <div class="wrap">
      <p class="kicker"><span class="dot dot--g"></span> 2ᵉ BAC Sciences expérimentales · PC</p>
      <h1>Les <em>chapitres</em></h1>
      <p class="lead">Cherchez une notion, filtrez par semestre ou par statut, et reprenez là où vous vous êtes arrêté. La progression reste sur cet appareil.</p>
    </div>
  </section>

  <section class="section--tight paper-grid">
    <div class="wrap">
      <form class="toolbar" role="search" aria-label="Filtrer les chapitres" data-filters onsubmit="return false">
        <div class="field toolbar__search">
          <label for="q">Rechercher une notion</label>
          <div class="search">
            <Icon name="search" />
            <input class="input" id="q" type="search" placeholder="ex. tangente, TVI, ln, intégrale…" autocomplete="off" data-q />
          </div>
        </div>
        <div class="field">
          <span class="label" id="lbl-sem">Semestre</span>
          <div class="chips" role="group" aria-labelledby="lbl-sem">
            <button type="button" class="chip" aria-pressed="true" data-sem="all">Tous</button>
            <button type="button" class="chip" aria-pressed="false" data-sem="1">S1</button>
            <button type="button" class="chip" aria-pressed="false" data-sem="2">S2</button>
          </div>
        </div>
        <div class="field">
          <span class="label" id="lbl-st">Statut</span>
          <div class="chips" role="group" aria-labelledby="lbl-st">
            <button type="button" class="chip" aria-pressed="true" data-status="all">Tout</button>
            <button type="button" class="chip" aria-pressed="false" data-status="video">Avec vidéo du prof</button>
            <button type="button" class="chip" aria-pressed="false" data-status="todo">À travailler</button>
            <button type="button" class="chip" aria-pressed="false" data-status="done">Maîtrisés</button>
            <button type="button" class="chip" aria-pressed="false" data-status="saved">Enregistrés</button>
          </div>
        </div>
      </form>
      <p class="count" role="status" aria-live="polite" data-count>{chapters.length} chapitres</p>

      <ol class="chlist" data-list>
        {chapters.map((c) => {
          const nEx = exercisesFor(c.slug).length;
          const search = [c.fr, c.ar, c.hook, c.summary, ...c.checkpoints, ...c.formulas.map((f) => f.label)].join(' ').toLowerCase();
          return (
            <li class="chrow" data-slug={c.slug} data-sem={c.semester} data-videos={vids(c.slug)} data-search={search} data-total={c.checkpoints.length + nEx}>
              <a class="chrow__link" href={url(`cours/${c.slug}/`)}>
                <span class="chrow__n">{String(c.n).padStart(2, '0')}</span>
                <span class="chrow__body">
                  <span class="chrow__t">{c.fr}</span>
                  <span class="chrow__ar" lang="ar">{c.ar}</span>
                  <span class="chrow__hook">{c.hook}</span>
                  <span class="chrow__meta">
                    <span>S{c.semester}</span>
                    <span>{vids(c.slug) ? `${vids(c.slug)} vidéo${vids(c.slug) > 1 ? 's' : ''} du prof` : 'Vidéo à venir'}</span>
                    <span>{nEx} exercice{nEx > 1 ? 's' : ''}</span>
                    <span class="chrow__state" data-state></span>
                  </span>
                  <span class="meter" aria-hidden="true"><span data-meter></span></span>
                </span>
                <span class="chrow__fig"><ChapterFigure kind={c.figure} /></span>
              </a>
            </li>
          );
        })}
      </ol>
      <ChMeta />
      <p class="empty" data-empty hidden>Aucun chapitre ne correspond. <button type="button" class="link-btn" data-clear>Effacer les filtres</button></p>

      <h2 class="coll-title">Hors programme, mais essentiel</h2>
      <ul class="coll">
        {Object.entries(collections).map(([k, c]) => (
          <li><a href={url(`videos/?t=${k}`)}><b>{c.fr}</b> <span lang="ar" class="ar">{c.ar}</span><small>{c.blurb} · {videos.filter((v) => v.topic === k).length} vidéos</small></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .toolbar { display: grid; gap: 1.1rem; padding: 1.2rem; background: #fff; border: 1px solid var(--rule); }
  @media (min-width: 900px) { .toolbar { grid-template-columns: 1.2fr auto; align-items: end; } .toolbar .field:last-child { grid-column: 1 / -1; } }
  .search { position: relative; }
  .search svg { position: absolute; left: 0.8rem; top: 50%; width: 20px; height: 20px; transform: translateY(-50%); color: var(--ink-3); }
  .search .input { padding-left: 2.5rem; }
  .count { margin: 1.2rem 0 0.4rem; font-size: 0.88rem; color: var(--ink-3); }
  .chlist { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .chrow { border-bottom: 1px solid var(--rule); background: var(--paper); }
  .chrow__link { display: grid; grid-template-columns: 2.6rem 1fr; gap: 0.6rem 1rem; padding: 1.3rem 0.2rem; text-decoration: none; }
  @media (min-width: 760px) { .chrow__link { grid-template-columns: 4rem 1fr 220px; gap: 1.5rem; align-items: center; } }
  .chrow__n { font-family: var(--f-display); font-style: italic; font-size: 2rem; color: var(--ink-3); line-height: 1; }
  .chrow__body { display: grid; gap: 0.25rem; }
  .chrow__t { font-family: var(--f-display); font-size: clamp(1.4rem, 1.2rem + 0.8vw, 2rem); line-height: 1.15; }
  .chrow__ar { font-family: var(--f-ar); color: var(--ink-3); font-size: 1.05rem; }
  .chrow__hook { color: var(--ink-2); max-width: 40rem; }
  .chrow__meta { display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; font-size: 0.8rem; color: var(--ink-3); margin-top: 0.3rem; }
  .chrow__state:empty { display: none; }
  .chrow__state { color: var(--green); font-weight: 700; }
  .chrow .meter { max-width: 22rem; margin-top: 0.5rem; }
  .chrow__fig { display: none; }
  @media (min-width: 760px) { .chrow__fig { display: block; } }
  .chrow__link:hover .chrow__t { color: var(--red); }
  .chrow__link:hover .chrow__n { color: var(--red); }
  .empty { padding: 2rem 0; }
  .link-btn { background: none; border: 0; text-decoration: underline; color: var(--blue); padding: 0.5rem; min-height: 44px; }
  .coll-title { font-size: var(--step-2); margin: 3.5rem 0 1rem; }
  .coll { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; border-top: 1px solid var(--rule); }
  @media (min-width: 760px) { .coll { grid-template-columns: 1fr 1fr; column-gap: 2rem; } }
  .coll a { display: grid; gap: 0.15rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .coll b { font-family: var(--f-display); font-weight: 500; font-size: 1.25rem; }
  .coll .ar { color: var(--ink-3); justify-self: start; }
  .coll small { color: var(--ink-3); font-size: 0.85rem; }
  .coll a:hover b { color: var(--red); }
</style>

<script>
  import { load } from '../../lib/store';
  import { chapterProgress } from '../../lib/progress';
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-list] .chrow'));
  const q = document.querySelector<HTMLInputElement>('[data-q]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  let sem = 'all', status = 'all';
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  const meta: Record<string, { checks: number; ex: string[] }> = JSON.parse(document.getElementById('ch-meta')?.textContent || '{}');
  const progress = (slug: string) => chapterProgress(load(), slug, meta[slug]?.checks ?? 0, meta[slug]?.ex ?? []);

  function apply() {
    const term = norm(q.value.trim());
    let n = 0;
    for (const r of rows) {
      const slug = r.dataset.slug!;
      const p = progress(slug);
      r.querySelector<HTMLElement>('[data-meter]')!.style.width = p.pct + '%';
      r.querySelector<HTMLElement>('[data-state]')!.textContent = p.mastered ? '✓ maîtrisé' : p.pct ? `${p.pct} %` : '';
      let show = (sem === 'all' || r.dataset.sem === sem) && (!term || norm(r.dataset.search!).includes(term));
      if (status === 'video') show &&= Number(r.dataset.videos) > 0;
      if (status === 'todo') show &&= !p.mastered;
      if (status === 'done') show &&= p.mastered;
      if (status === 'saved') show &&= p.saved;
      r.hidden = !show;
      if (show) n++;
    }
    count.textContent = `${n} chapitre${n > 1 ? 's' : ''}`;
    empty.hidden = n > 0;
  }
  const bindChips = (attr: string, set: (v: string) => void) =>
    document.querySelectorAll<HTMLButtonElement>(`[data-${attr}]`).forEach((b) =>
      b.addEventListener('click', () => {
        document.querySelectorAll(`[data-${attr}]`).forEach((x) => x.setAttribute('aria-pressed', 'false'));
        b.setAttribute('aria-pressed', 'true');
        set(b.getAttribute(`data-${attr}`)!);
        apply();
      }));
  bindChips('sem', (v) => (sem = v));
  bindChips('status', (v) => (status = v));
  q.addEventListener('input', apply);
  document.querySelector('[data-clear]')?.addEventListener('click', () => {
    q.value = ''; sem = 'all'; status = 'all';
    document.querySelectorAll<HTMLButtonElement>('[data-sem],[data-status]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sem === 'all' || b.dataset.status === 'all')));
    apply();
  });
  const pre = new URLSearchParams(location.search).get('q');
  if (pre) q.value = pre.slice(0, 60);
  window.addEventListener('phm:change', apply);
  apply();
</script>
