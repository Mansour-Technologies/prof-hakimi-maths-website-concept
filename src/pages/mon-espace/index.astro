---
import Base from '../../layouts/Base.astro';
import ChMeta from '../../components/ChMeta.astro';
import Icon from '../../components/Icon.astro';
import { chapters } from '../../data/chapters';
import { videos } from '../../data/videos';
import { exercises } from '../../data/exercises';
import { url } from '../../lib/url';

const vidIndex = Object.fromEntries(videos.map((v) => [v.id, { t: v.title, k: v.kind }]));
const exIndex = Object.fromEntries(exercises.map((e) => [e.id, e.chapter]));
---
<Base title="Mon espace" active="mon-espace/" description="Tableau de bord de démonstration : progression par chapitre, résultats d'exercices, favoris, objectifs et prochaine leçon recommandée. Stocké uniquement sur cet appareil.">
  <section class="page-hero board chalk-grid">
    <div class="wrap">
      <p class="kicker"><span class="dot dot--g"></span> Tableau de bord · démonstration</p>
      <h1>Mon <em>espace</em></h1>
      <p class="lead">Votre progression, vos favoris et vos objectifs — enregistrés uniquement dans ce navigateur. Pas de compte, pas de donnée personnelle.</p>
    </div>
  </section>

  <section class="section--tight paper-grid" data-dash>
    <div class="wrap dash">
      <article class="card card--next">
        <p class="kicker"><span class="dot"></span> Prochaine étape recommandée</p>
        <h2 data-next-title>…</h2>
        <p data-next-why></p>
        <a class="btn" data-next-link href={url('cours/')}>Reprendre <Icon name="arrow" /></a>
      </article>

      <article class="card card--overall">
        <h2>Vue d’ensemble</h2>
        <div class="ring-row">
          <svg class="ring" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="50" class="ring__bg" /><circle cx="60" cy="60" r="50" class="ring__fg" data-ring pathLength="100" /></svg>
          <dl class="stats">
            <div><dt>Progression globale</dt><dd data-s-pct>0 %</dd></div>
            <div><dt>Exercices réussis</dt><dd data-s-ex>0 / {exercises.length}</dd></div>
            <div><dt>Chapitres maîtrisés</dt><dd data-s-ch>0 / {chapters.length}</dd></div>
            <div><dt>Séances terminées</dt><dd data-s-sess>0</dd></div>
          </dl>
        </div>
      </article>

      <article class="card card--chapters">
        <h2>Progression par chapitre</h2>
        <ol class="bars" data-bars>
          {chapters.map((c) => (
            <li data-bar={c.slug}>
              <a href={url(`cours/${c.slug}/`)}><span class="bars__n">{c.n}</span><span class="bars__t">{c.fr}</span><span class="bars__p" data-bar-p>0 %</span></a>
              <div class="meter"><span data-bar-m></span></div>
            </li>
          ))}
        </ol>
      </article>

      <article class="card card--results">
        <h2>Derniers résultats</h2>
        <ul class="results" data-results></ul>
        <p class="empty-note" data-results-empty>Aucun exercice tenté pour l’instant. <a href={url('examen/')}>Commencer au centre examen</a>.</p>
      </article>

      <article class="card card--bm">
        <h2>Favoris</h2>
        <ul class="bml" data-bml></ul>
        <p class="empty-note" data-bml-empty>Enregistrez un chapitre ou une vidéo avec le bouton <Icon name="bookmark" class="inl" /> pour le retrouver ici.</p>
      </article>

      <article class="card card--goals">
        <h2>Objectifs</h2>
        <form class="goal-form" data-goal-form>
          <label class="sr-only" for="goal-in">Nouvel objectif</label>
          <input class="input" id="goal-in" maxlength="140" placeholder="ex. Finir les exercices de suites avant dimanche" data-goal-in autocomplete="off" />
          <button class="btn btn--sm" type="submit">Ajouter</button>
        </form>
        <ul class="goals" data-goals></ul>
        <p class="empty-note" data-goals-empty>Fixez-vous un objectif concret pour la semaine.</p>
      </article>

      <article class="card card--sess">
        <h2>Historique des séances</h2>
        <ul class="sess" data-sessions></ul>
        <p class="empty-note" data-sess-empty>Terminez une séance ou une épreuve chrono pour voir votre bilan ici.</p>
      </article>

      <article class="card card--reset">
        <h2>Données de démonstration</h2>
        <p>Tout est stocké dans le <code>localStorage</code> de ce navigateur, sous une seule clé. Rien n’est envoyé.</p>
        <button type="button" class="btn btn--ghost" data-reset-all><Icon name="reset" /> Tout réinitialiser</button>
        <p class="confirm" data-confirm hidden>
          Effacer progression, favoris, objectifs et séances&nbsp;?
          <button type="button" class="btn btn--red btn--sm" data-reset-yes>Oui, effacer</button>
          <button type="button" class="btn btn--ghost btn--sm" data-reset-no>Annuler</button>
        </p>
      </article>
    </div>
  </section>
  <ChMeta />
  <script type="application/json" id="vid-index" set:html={JSON.stringify(vidIndex)} />
  <script type="application/json" id="ex-index" set:html={JSON.stringify(exIndex)} />
</Base>

<style>
  .dash { display: grid; gap: 1.2rem; }
  @media (min-width: 960px) {
    .dash { grid-template-columns: repeat(6, 1fr); }
    .card--next { grid-column: span 3; } .card--overall { grid-column: span 3; }
    .card--chapters { grid-column: span 3; grid-row: span 2; } .card--results { grid-column: span 3; }
    .card--bm { grid-column: span 3; } .card--goals { grid-column: span 3; } .card--sess { grid-column: span 3; } .card--reset { grid-column: span 6; }
  }
  .card { background: #fff; border: 1px solid var(--rule); padding: 1.3rem; min-width: 0; }
  .card h2 { font-size: var(--step-2); margin-bottom: 1rem; }
  .card--next { background: var(--board); color: var(--chalk); border-color: var(--board); }
  .card--next h2 { font-size: var(--step-3); margin: 0.6rem 0; }
  .card--next p { color: var(--chalk-2); }
  .card--next .kicker { color: var(--chalk-2); }
  .card--next .btn { --bg: var(--chalk); --fg: var(--board); }
  .ring-row { display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap; }
  .ring { width: 120px; height: 120px; transform: rotate(-90deg); flex: none; }
  .ring__bg { fill: none; stroke: var(--grid); stroke-width: 10; }
  .ring__fg { fill: none; stroke: var(--green); stroke-width: 10; stroke-linecap: round; stroke-dasharray: 0 100; transition: stroke-dasharray 0.6s var(--ease); }
  .stats { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem 1.5rem; flex: 1; min-width: 200px; }
  .stats dt { font-size: 0.78rem; color: var(--ink-3); }
  .stats dd { margin: 0; font-family: var(--f-display); font-size: 1.6rem; }
  .bars { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  .bars a { display: grid; grid-template-columns: 1.6rem 1fr auto; gap: 0.5rem; text-decoration: none; font-size: 0.92rem; margin-bottom: 0.25rem; }
  .bars__n { font-family: var(--f-display); font-style: italic; color: var(--ink-3); }
  .bars__p { font-variant-numeric: tabular-nums; color: var(--ink-3); }
  .bars a:hover .bars__t { color: var(--red); }
  .results, .bml, .goals, .sess { list-style: none; padding: 0; margin: 0; display: grid; }
  .results li, .sess li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; border-bottom: 1px solid var(--grid); font-size: 0.92rem; }
  .results .ok { color: var(--green); font-weight: 700; } .results .ko { color: var(--red); font-weight: 700; }
  .bml li { display: flex; justify-content: space-between; align-items: center; gap: 0.8rem; border-bottom: 1px solid var(--grid); }
  .bml a { padding: 0.6rem 0; flex: 1; min-width: 0; }
  .x { background: none; border: 0; color: var(--ink-3); min-width: 44px; min-height: 44px; font-size: 0.82rem; text-decoration: underline; }
  .goal-form { display: flex; gap: 0.5rem; margin-bottom: 0.6rem; }
  .goals li { display: flex; align-items: center; gap: 0.6rem; border-bottom: 1px solid var(--grid); }
  .goals label { flex: 1; display: flex; gap: 0.7rem; align-items: center; min-height: 48px; cursor: pointer; }
  .goals input { width: 1.2rem; height: 1.2rem; accent-color: var(--green); flex: none; }
  .goals label:has(input:checked) span { text-decoration: line-through; color: var(--ink-3); }
  .empty-note { color: var(--ink-3); font-size: 0.9rem; margin: 0.4rem 0 0; }
  .empty-note :global(.inl) { display: inline; width: 1em; height: 1em; vertical-align: -0.15em; }
  .confirm { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-top: 1rem; font-weight: 600; }
  @media (max-width: 420px) { .goal-form { flex-direction: column; } }
</style>

<script>
  import { load, update, reset, toggleIn } from '../../lib/store';
  import { chapterProgress } from '../../lib/progress';
  const meta: Record<string, { n: number; fr: string; checks: number; ex: string[]; video: string | null }> = JSON.parse(document.getElementById('ch-meta')?.textContent || '{}');
  const vids: Record<string, { t: string; k: string }> = JSON.parse(document.getElementById('vid-index')?.textContent || '{}');
  const exCh: Record<string, string> = JSON.parse(document.getElementById('ex-index')?.textContent || '{}');
  const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const q = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const li = (html = '') => { const el = document.createElement('li'); el.innerHTML = html; return el; };
  const text = (el: Element, sel: string, t: string) => { el.querySelector(sel)!.textContent = t; };

  function paint() {
    const s = load();
    const slugs = Object.keys(meta);
    const prog = slugs.map((slug) => ({ slug, ...chapterProgress(s, slug, meta[slug]!.checks, meta[slug]!.ex) }));
    const overall = Math.round(prog.reduce((a, p) => a + p.pct, 0) / (prog.length || 1));
    q('[data-ring]').setAttribute('stroke-dasharray', `${overall} 100`);
    q('[data-ring]').style.opacity = overall ? '1' : '0';
    q('[data-s-pct]').textContent = `${overall} %`;
    const solved = Object.entries(s.results).filter(([id, r]) => r.ok && exCh[id]).length;
    q('[data-s-ex]').textContent = `${solved} / ${Object.keys(exCh).length}`;
    q('[data-s-ch]').textContent = `${prog.filter((p) => p.mastered).length} / ${slugs.length}`;
    q('[data-s-sess]').textContent = String(s.sessions.length);
    for (const p of prog) {
      const row = q(`[data-bar="${p.slug}"]`);
      row.querySelector<HTMLElement>('[data-bar-m]')!.style.width = p.pct + '%';
      row.querySelector('[data-bar-p]')!.textContent = p.mastered ? '✓ 100 %' : `${p.pct} %`;
    }
    // next recommended lesson: first chapter (in curriculum order) not mastered, preferring one already started
    const started = prog.find((p) => !p.mastered && p.pct > 0 && p.pct < 100);
    const next = started ?? prog.find((p) => !p.mastered);
    if (next) {
      const m = meta[next.slug]!;
      q('[data-next-title]').textContent = `${m.n}. ${m.fr}`;
      q('[data-next-why]').textContent = started
        ? `Vous êtes à ${next.pct} % sur ce chapitre : terminez les objectifs et les exercices restants.`
        : m.video ? 'Premier chapitre non maîtrisé dans l’ordre du programme — avec une vidéo du professeur pour démarrer.' : 'Premier chapitre non maîtrisé dans l’ordre du programme.';
      q<HTMLAnchorElement>('[data-next-link]').href = `${BASE}cours/${next.slug}/`;
    } else {
      q('[data-next-title]').textContent = 'Tous les chapitres sont maîtrisés';
      q('[data-next-why]').textContent = 'Passez à une épreuve chrono pour vous tester en conditions réelles.';
      q<HTMLAnchorElement>('[data-next-link]').href = `${BASE}examen/`;
    }
    // results
    const rl = q('[data-results]'); rl.innerHTML = '';
    const recent = Object.entries(s.results).filter(([id]) => exCh[id]).sort((a, b) => b[1].at - a[1].at).slice(0, 8);
    for (const [id, r] of recent) {
      const el = li('<span></span><span></span>');
      const ch = meta[exCh[id]!];
      el.children[0]!.textContent = `${ch ? ch.fr : ''} · ${id.toUpperCase()}`;
      el.children[1]!.textContent = r.ok ? `réussi (${r.tries} essai${r.tries > 1 ? 's' : ''})` : 'à revoir';
      el.children[1]!.className = r.ok ? 'ok' : 'ko';
      rl.append(el);
    }
    q('[data-results-empty]').hidden = recent.length > 0;
    // bookmarks
    const bl = q('[data-bml]'); bl.innerHTML = '';
    const valid = s.bookmarks.filter((b) => (b.startsWith('ch:') && meta[b.slice(3)]) || (b.startsWith('vid:') && vids[b.slice(4)]));
    for (const b of valid) {
      const el = li('<a></a><button type="button" class="x">Retirer</button>');
      const a = el.querySelector('a')!;
      if (b.startsWith('ch:')) { a.href = `${BASE}cours/${b.slice(3)}/`; a.textContent = `Chapitre — ${meta[b.slice(3)]!.fr}`; }
      else { a.href = `https://www.youtube.com/watch?v=${b.slice(4)}`; a.target = '_blank'; a.rel = 'noopener'; a.textContent = `Vidéo — ${vids[b.slice(4)]!.t}`; a.dir = 'auto'; }
      const x = el.querySelector('button')!;
      x.setAttribute('aria-label', `Retirer ${a.textContent} des favoris`);
      x.addEventListener('click', () => update((st) => { toggleIn(st.bookmarks, b); }));
      bl.append(el);
    }
    q('[data-bml-empty]').hidden = valid.length > 0;
    // goals
    const gl = q('[data-goals]'); gl.innerHTML = '';
    for (const g of s.goals) {
      const el = li('<label><input type="checkbox" /><span></span></label><button type="button" class="x">Supprimer</button>');
      const cb = el.querySelector('input')!; cb.checked = g.done;
      text(el, 'span', g.text);
      cb.addEventListener('change', () => update((st) => { const t = st.goals.find((x) => x.id === g.id); if (t) t.done = cb.checked; }));
      const del = el.querySelector('button')!;
      del.setAttribute('aria-label', `Supprimer l’objectif ${g.text}`);
      del.addEventListener('click', () => update((st) => { st.goals = st.goals.filter((x) => x.id !== g.id); }));
      gl.append(el);
    }
    q('[data-goals-empty]').hidden = s.goals.length > 0;
    // sessions
    const sl = q('[data-sessions]'); sl.innerHTML = '';
    for (const se of s.sessions.slice().reverse().slice(0, 6)) {
      const el = li('<span></span><b></b>');
      const d = new Date(se.at);
      el.children[0]!.textContent = `${se.mode === 'chrono' ? 'Épreuve chrono' : 'Séance libre'} · ${isNaN(d.getTime()) ? '' : d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}`;
      el.children[1]!.textContent = `${se.correct} / ${se.total} · ${Math.round(se.seconds / 60)} min`;
      sl.append(el);
    }
    q('[data-sess-empty]').hidden = s.sessions.length > 0;
  }

  q<HTMLFormElement>('[data-goal-form]').addEventListener('submit', (e) => {
    e.preventDefault();
    const inp = q<HTMLInputElement>('[data-goal-in]');
    const t = inp.value.trim().slice(0, 140);
    if (!t) { inp.focus(); return; }
    update((s) => { s.goals.push({ id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6), text: t, done: false }); s.goals = s.goals.slice(-30); });
    inp.value = '';
    (window as any).phmToast?.('Objectif ajouté');
  });
  const confirmBox = q('[data-confirm]');
  q('[data-reset-all]').addEventListener('click', () => { confirmBox.hidden = false; q<HTMLButtonElement>('[data-reset-no]').focus(); });
  q('[data-reset-no]').addEventListener('click', () => { confirmBox.hidden = true; q<HTMLButtonElement>('[data-reset-all]').focus(); });
  q('[data-reset-yes]').addEventListener('click', () => { reset(); confirmBox.hidden = true; q<HTMLButtonElement>('[data-reset-all]').focus(); (window as any).phmToast?.('Données de démonstration effacées'); });
  window.addEventListener('phm:change', paint);
  paint();
</script>
