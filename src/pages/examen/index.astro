---
import Base from '../../layouts/Base.astro';
import Exercise from '../../components/Exercise.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import Icon from '../../components/Icon.astro';
import { chapters } from '../../data/chapters';
import { exercises, difficultyLabel } from '../../data/exercises';
import { videos } from '../../data/videos';
import { url } from '../../lib/url';

const single = exercises.filter((e) => !e.group);
const groups = [...new Set(exercises.filter((e) => e.group).map((e) => e.group!))];
const advice = videos.find((v) => v.id === 'DRtFE7U26-w')!;
const general = [
  { id: 'g-formulaire', t: 'Relire le formulaire : dérivées, primitives, limites usuelles' },
  { id: 'g-sujet', t: 'Traiter un sujet complet en temps réel (3 h)' },
  { id: 'g-redaction', t: 'Soigner la rédaction : hypothèses, théorèmes cités, conclusion' },
  { id: 'g-calculatrice', t: 'Vérifier le matériel autorisé et la calculatrice' },
];
const chapterNames = Object.fromEntries(chapters.map((c) => [c.slug, c.fr]));
---
<Base title="Examen national — centre de préparation" active="examen/" description="Centre de préparation à l'examen national du BAC (démonstration) : exercices type BAC par chapitre et difficulté, problèmes guidés, épreuve chronométrée, checklist et bilan de séance.">
  <section class="page-hero board chalk-grid">
    <div class="wrap">
      <p class="kicker"><span class="dot"></span> 2ᵉ BAC · Examen national</p>
      <h1>Centre <em>examen</em></h1>
      <p class="lead">Des exercices type BAC corrigés pas à pas, une épreuve chronométrée et une checklist de révision. Tout est original et proposé à titre de démonstration — ce ne sont pas des sujets officiels.</p>
      <p class="demo-tag">Contenu de démonstration</p>
    </div>
  </section>

  <section class="section--tight paper-grid">
    <div class="wrap exam-top">
      <div class="panel">
        <h2>Épreuve chrono</h2>
        <p>Un tirage d’exercices selon vos filtres, un minuteur, puis un bilan par chapitre.</p>
        <form class="chrono-form" data-chrono-form>
          <div class="field">
            <label for="ch-n">Nombre d’exercices</label>
            <select id="ch-n" class="input" data-ch-n><option value="4">4</option><option value="6" selected>6</option><option value="8">8</option></select>
          </div>
          <div class="field">
            <label for="ch-t">Durée</label>
            <select id="ch-t" class="input" data-ch-t><option value="300">5 min</option><option value="600" selected>10 min</option><option value="1200">20 min</option></select>
          </div>
          <button class="btn btn--red" type="submit"><Icon name="exam" /> Lancer l’épreuve</button>
        </form>
      </div>
      <div class="panel panel--check">
        <h2>Checklist de révision</h2>
        <div class="meter"><span data-ck-meter></span></div>
        <p class="ck-count" data-ck-count>0 / {chapters.length + general.length}</p>
        <details class="ck-details" open>
          <summary>Méthode</summary>
          <ul class="ck">{general.map((g) => <li><label><input type="checkbox" data-ck={g.id} /><span>{g.t}</span></label></li>)}</ul>
        </details>
        <details class="ck-details">
          <summary>Chapitres révisés</summary>
          <ul class="ck">{chapters.map((c) => <li><label><input type="checkbox" data-ck={`c-${c.slug}`} /><span>{c.n}. {c.fr}</span></label></li>)}</ul>
        </details>
      </div>
      <div class="panel panel--video">
        <h2>Les conseils du prof</h2>
        <VideoFacade video={advice} />
        <p class="mixed" dir="auto" lang="ar">{advice.title}</p>
      </div>
    </div>
  </section>

  <!-- Chrono mode -->
  <section class="chrono board" data-chrono hidden aria-labelledby="chrono-title">
    <div class="wrap">
      <div class="chrono__bar">
        <h2 id="chrono-title">Épreuve en cours</h2>
        <p class="chrono__time" data-time role="timer" aria-live="off">10:00</p>
        <p class="chrono__score" data-chrono-score aria-live="polite">0 / 0</p>
        <button type="button" class="btn btn--chalk btn--sm" data-chrono-end>Terminer et voir le bilan</button>
      </div>
    </div>
  </section>
  <div class="wrap chrono-list" data-chrono-list hidden></div>

  <!-- Summary -->
  <section class="wrap summary" data-summary hidden tabindex="-1" aria-labelledby="sum-title">
    <h2 id="sum-title">Bilan de séance</h2>
    <p class="summary__big" data-sum-big></p>
    <ul class="summary__list" data-sum-list></ul>
    <p data-sum-reco></p>
    <div class="summary__actions">
      <a class="btn" href={url('mon-espace/')}>Voir Mon espace</a>
      <button type="button" class="btn btn--ghost" data-sum-close>Revenir aux exercices</button>
    </div>
  </section>

  <section class="section--tight bank" data-bank aria-labelledby="bank-title">
    <div class="wrap">
      <div class="bank__head">
        <h2 id="bank-title">Banque d’exercices</h2>
        <p class="session" aria-live="polite"><span data-sess>Séance : 0 réussi sur 0 tenté</span> <button type="button" class="link-btn" data-sess-end>Terminer la séance</button></p>
      </div>
      <div class="filters">
        <div class="field">
          <label for="f-ch">Chapitre</label>
          <select id="f-ch" class="input" data-f-ch>
            <option value="all">Tous les chapitres</option>
            {chapters.map((c) => <option value={c.slug}>{c.n}. {c.fr}</option>)}
          </select>
        </div>
        <div class="field">
          <span class="label" id="lbl-d">Difficulté</span>
          <div class="chips" role="group" aria-labelledby="lbl-d">
            <button type="button" class="chip" aria-pressed="true" data-f-d="all">Toutes</button>
            {([1, 2, 3] as const).map((d) => <button type="button" class="chip" aria-pressed="false" data-f-d={String(d)}>{difficultyLabel[d]}</button>)}
          </div>
        </div>
        <label class="tog-l"><input type="checkbox" data-f-todo /> Seulement à revoir / non faits</label>
      </div>
      <p class="count" data-f-count role="status" aria-live="polite"></p>
      <div class="exlist" data-exlist>
        {single.map((e, i) => <Exercise ex={e} index={i + 1} showChapter />)}
      </div>
      <p class="more"><button type="button" class="btn btn--ghost" data-more hidden>Afficher plus d’exercices</button></p>

      <h2 class="pb-title">Problèmes guidés type examen</h2>
      {groups.map((g) => (
        <div class="pb" data-pb>
          <h3 class="pb__t">{g}</h3>
          <div class="exlist">
            {exercises.filter((e) => e.group === g).map((e, i) => <Exercise ex={e} index={i + 1} headingLevel="h4" />)}
          </div>
        </div>
      ))}
    </div>
  </section>
  <script type="application/json" id="ch-names" set:html={JSON.stringify(chapterNames)} />
</Base>

<style>
  .exam-top { display: grid; gap: 1.2rem; }
  @media (min-width: 1000px) { .exam-top { grid-template-columns: 1fr 1fr 1fr; align-items: start; } }
  .panel { background: #fff; border: 1px solid var(--rule); border-top: 3px solid var(--ink); padding: 1.3rem; }
  .panel h2 { font-size: var(--step-2); margin-bottom: 0.6rem; }
  .panel > p { color: var(--ink-2); font-size: 0.95rem; }
  .chrono-form { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; align-items: end; }
  .chrono-form .btn { grid-column: 1 / -1; }
  .panel--check .meter { margin: 0.6rem 0 0.3rem; }
  .ck-count { font-size: 0.82rem; color: var(--ink-3); margin-bottom: 0.4rem; }
  .ck-details summary { cursor: pointer; font-weight: 600; min-height: 44px; display: flex; align-items: center; border-top: 1px solid var(--grid); }
  .ck { list-style: none; padding: 0; margin: 0 0 0.6rem; display: grid; }
  .ck label { display: flex; gap: 0.7rem; align-items: center; min-height: 44px; font-size: 0.92rem; cursor: pointer; }
  .ck input { width: 1.2rem; height: 1.2rem; accent-color: var(--green); flex: none; }
  .ck label:has(input:checked) span { color: var(--ink-3); text-decoration: line-through; }
  .panel--video p { font-size: 1.1rem; margin: 0.8rem 0 0; }
  .chrono { position: sticky; top: var(--header-h); z-index: 20; padding-block: 0.8rem; border-bottom: 1px solid var(--board-3); }
  .chrono__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.4rem; }
  .chrono__bar h2 { font-size: 1.2rem; }
  .chrono__time { margin: 0; font-family: var(--f-math); font-size: 1.6rem; color: var(--chalk-yellow); font-variant-numeric: tabular-nums; }
  .chrono__time[data-low='true'] { color: var(--red-hi); }
  .chrono__score { margin: 0; color: var(--chalk-2); }
  .chrono__bar .btn { margin-left: auto; }
  .chrono-list { display: grid; gap: 1.2rem; padding-block: 2rem 3rem; }
  .summary { padding-block: 2.5rem 3rem; }
  .summary h2 { font-size: var(--step-3); }
  .summary__big { font-family: var(--f-display); font-size: var(--step-4); margin: 0.6rem 0 1rem; }
  .summary__list { list-style: none; padding: 0; margin: 0 0 1rem; display: grid; gap: 0.3rem; max-width: 36rem; }
  .summary__list li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--rule); }
  .summary__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .bank__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.5rem 2rem; border-bottom: 2px solid var(--ink); padding-bottom: 0.8rem; margin-bottom: 1.2rem; }
  .bank__head h2 { font-size: var(--step-3); }
  .session { margin: 0; color: var(--ink-2); font-size: 0.92rem; }
  .link-btn { background: none; border: 0; text-decoration: underline; color: var(--blue); padding: 0.4rem; min-height: 44px; font-size: inherit; }
  .filters { display: grid; gap: 1rem; }
  @media (min-width: 900px) { .filters { grid-template-columns: minmax(240px, 320px) 1fr auto; align-items: end; } }
  .tog-l { display: flex; gap: 0.6rem; align-items: center; min-height: 48px; font-size: 0.92rem; }
  .tog-l input { width: 1.2rem; height: 1.2rem; accent-color: var(--ink); }
  .count { font-size: 0.88rem; color: var(--ink-3); margin: 1rem 0; }
  .exlist { display: grid; gap: 1.2rem; }
  @media (min-width: 1100px) { .exlist { grid-template-columns: 1fr 1fr; align-items: start; } }
  .more { margin: 1.2rem 0 0; }
  .pb-title { font-size: var(--step-3); margin: 3.5rem 0 1rem; padding-top: 1.5rem; border-top: 2px solid var(--ink); }
  .pb { margin-bottom: 2.5rem; }
  .pb__t { font-size: var(--step-1); font-family: var(--f-display); color: var(--blue); margin-bottom: 1rem; }
</style>

<script>
  import { load, update, toggleIn } from '../../lib/store';
  const names: Record<string, string> = JSON.parse(document.getElementById('ch-names')?.textContent || '{}');
  // ——— checklist ———
  const cks = Array.from(document.querySelectorAll<HTMLInputElement>('[data-ck]'));
  const paintCk = () => {
    const s = new Set(load().bacChecklist);
    cks.forEach((c) => (c.checked = s.has(c.dataset.ck!)));
    const n = cks.filter((c) => c.checked).length;
    document.querySelector<HTMLElement>('[data-ck-meter]')!.style.width = `${Math.round((n / cks.length) * 100)}%`;
    document.querySelector('[data-ck-count]')!.textContent = `${n} / ${cks.length} points cochés`;
  };
  cks.forEach((c) => c.addEventListener('change', () => update((s) => { if (c.checked !== s.bacChecklist.includes(c.dataset.ck!)) toggleIn(s.bacChecklist, c.dataset.ck!); })));

  // ——— filters ———
  const bankItems = Array.from(document.querySelectorAll<HTMLElement>('[data-exlist] [data-ex]'));
  const fCh = document.querySelector<HTMLSelectElement>('[data-f-ch]')!;
  const fTodo = document.querySelector<HTMLInputElement>('[data-f-todo]')!;
  let diff = 'all';
  const PAGE = 10;
  let limit = PAGE;
  const moreBtn = document.querySelector<HTMLButtonElement>('[data-more]')!;
  moreBtn.addEventListener('click', () => {
    const firstNew = bankItems.filter((el) => el.hidden)[0];
    limit += PAGE; applyFilters();
    firstNew?.querySelector<HTMLElement>('input')?.focus();
  });
  const applyFilters = () => {
    const res = load().results;
    let n = 0;
    for (const el of bankItems) {
      let show = (fCh.value === 'all' || el.dataset.chapter === fCh.value) && (diff === 'all' || el.dataset.difficulty === diff);
      if (fTodo.checked) show &&= !res[el.dataset.ex!]?.ok;
      if (show) n++;
      el.hidden = !show || n > limit;
    }
    moreBtn.hidden = n <= limit;
    moreBtn.textContent = `Afficher plus d’exercices (${n - limit} restants)`;
    document.querySelector('[data-f-count]')!.textContent = `${n} exercice${n > 1 ? 's' : ''} correspondant${n > 1 ? 's' : ''}`;
  };
  document.querySelectorAll<HTMLButtonElement>('[data-f-d]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-f-d]').forEach((x) => x.setAttribute('aria-pressed', 'false'));
    b.setAttribute('aria-pressed', 'true'); diff = b.dataset.fD!; limit = PAGE; applyFilters();
  }));
  fCh.addEventListener('change', () => { limit = PAGE; applyFilters(); });
  fTodo.addEventListener('change', () => { limit = PAGE; applyFilters(); });
  const pre = new URLSearchParams(location.search).get('chapitre');
  if (pre && [...fCh.options].some((o) => o.value === pre)) fCh.value = pre;

  // ——— session tracking ———
  let session = new Map<string, boolean>();
  let started = Date.now();
  const sessEl = document.querySelector('[data-sess]')!;
  const paintSess = () => {
    const ok = [...session.values()].filter(Boolean).length;
    sessEl.textContent = `Séance : ${ok} réussi${ok > 1 ? 's' : ''} sur ${session.size} tenté${session.size > 1 ? 's' : ''}`;
    if (chronoOn) document.querySelector('[data-chrono-score]')!.textContent = `${ok} / ${chronoIds.length} réussis`;
  };
  document.addEventListener('ex:answered', (e) => {
    const d = (e as CustomEvent).detail as { id: string; ok: boolean; reset?: boolean };
    if (d.reset) session.delete(d.id); else session.set(d.id, (session.get(d.id) ?? false) || d.ok);
    paintSess();
  });

  const summary = document.querySelector<HTMLElement>('[data-summary]')!;
  function showSummary(mode: string, ids: string[], seconds: number) {
    const byCh = new Map<string, { ok: number; n: number }>();
    for (const id of ids) {
      const el = document.querySelector<HTMLElement>(`[data-ex="${id}"]`);
      const ch = el?.dataset.chapter ?? '?';
      const r = byCh.get(ch) ?? { ok: 0, n: 0 };
      r.n++; if (session.get(id)) r.ok++;
      byCh.set(ch, r);
    }
    const ok = ids.filter((id) => session.get(id)).length;
    document.querySelector('[data-sum-big]')!.textContent = `${ok} / ${ids.length} réussis · ${Math.floor(seconds / 60)} min ${String(seconds % 60).padStart(2, '0')} s`;
    const list = document.querySelector('[data-sum-list]')!;
    list.innerHTML = '';
    for (const [ch, r] of byCh) { const li = document.createElement('li'); li.innerHTML = `<span></span><b></b>`; li.querySelector('span')!.textContent = names[ch] ?? ch; li.querySelector('b')!.textContent = `${r.ok} / ${r.n}`; list.append(li); }
    const weak = [...byCh].filter(([, r]) => r.ok < r.n).map(([ch]) => ch);
    const reco = document.querySelector('[data-sum-reco]')!;
    reco.innerHTML = '';
    if (weak.length) {
      reco.append('À revoir en priorité : ');
      weak.forEach((ch, i) => { const a = document.createElement('a'); a.href = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}cours/${ch}/`; a.textContent = names[ch] ?? ch; reco.append(a); if (i < weak.length - 1) reco.append(', '); });
      reco.append('.');
    } else reco.textContent = ids.length ? 'Sans faute sur cette séance — passez au niveau « Approfondi ».' : 'Aucun exercice tenté pendant cette séance.';
    update((s) => { s.sessions.push({ at: Date.now(), total: ids.length, correct: ok, seconds, mode }); s.sessions = s.sessions.slice(-20); });
    summary.hidden = false;
    summary.focus();
    summary.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  }
  document.querySelector('[data-sess-end]')!.addEventListener('click', () => {
    showSummary('libre', [...session.keys()], Math.round((Date.now() - started) / 1000));
  });
  document.querySelector('[data-sum-close]')!.addEventListener('click', () => {
    summary.hidden = true; session = new Map(); started = Date.now(); paintSess();
    document.getElementById('bank-title')?.scrollIntoView();
  });

  // ——— chrono ———
  const chrono = document.querySelector<HTMLElement>('[data-chrono]')!;
  const chronoList = document.querySelector<HTMLElement>('[data-chrono-list]')!;
  const bank = document.querySelector<HTMLElement>('[data-bank]')!;
  const timeEl = document.querySelector<HTMLElement>('[data-time]')!;
  let chronoOn = false, chronoIds: string[] = [], timer = 0, remaining = 0, total = 0;
  const homes = new Map<HTMLElement, boolean>();
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  function endChrono() {
    if (!chronoOn) return;
    clearInterval(timer); chronoOn = false;
    const list = document.querySelector<HTMLElement>('[data-exlist]')!;
    bankItems.forEach((el) => list.append(el));
    homes.clear();
    chrono.hidden = true; chronoList.hidden = true; bank.hidden = false;
    showSummary('chrono', chronoIds, total - remaining);
    applyFilters();
  }
  document.querySelector<HTMLFormElement>('[data-chrono-form]')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const n = Number(document.querySelector<HTMLSelectElement>('[data-ch-n]')!.value);
    total = remaining = Number(document.querySelector<HTMLSelectElement>('[data-ch-t]')!.value);
    const saved = limit; limit = 999; applyFilters(); const pool = bankItems.filter((el) => !el.hidden); limit = saved;
    const pick = (pool.length >= n ? pool : bankItems).slice().sort(() => Math.random() - 0.5).slice(0, n);
    session = new Map(); summary.hidden = true;
    chronoIds = pick.map((el) => el.dataset.ex!);
    for (const el of pick) {
      homes.set(el, true);
      el.hidden = false;
      el.dispatchEvent(new CustomEvent('ex:clear'));
      chronoList.append(el);
    }
    session = new Map();
    chronoOn = true; bank.hidden = true; chrono.hidden = false; chronoList.hidden = false;
    timeEl.textContent = fmt(remaining); timeEl.dataset.low = 'false';
    paintSess();
    chrono.scrollIntoView();
    chronoList.querySelector<HTMLElement>('input')?.focus({ preventScroll: true });
    timer = window.setInterval(() => {
      remaining--;
      timeEl.textContent = fmt(Math.max(0, remaining));
      timeEl.dataset.low = String(remaining <= 60);
      if (remaining <= 0) { (window as any).phmToast?.('Temps écoulé'); endChrono(); }
    }, 1000);
  });
  document.querySelector('[data-chrono-end]')!.addEventListener('click', endChrono);

  window.addEventListener('phm:change', () => { paintCk(); if (fTodo.checked && !chronoOn) applyFilters(); });
  paintCk(); applyFilters(); paintSess();
</script>
