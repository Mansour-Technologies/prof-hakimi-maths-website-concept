---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { tex } from '../lib/tex';
---
<Base title="Page introuvable — Prof Hakimi maths" description="Cette page n'existe pas." home={false}>
  <section class="section nf">
    <div class="wrap">
      <p class="chap__label" aria-hidden="true">Erreur 404 :</p>
      <h1 class="chap__title">Hors du domaine</h1>
      <p class="lead">Cette adresse n’appartient pas au domaine de définition du site&nbsp;: <span set:html={tex('x\\notin D_f')} />.</p>
      <p style="margin-top:1.8rem;display:flex;gap:.7rem;flex-wrap:wrap"><a class="btn btn--ember" href={url('')}>Retour à l’accueil</a><a class="btn btn--line" href={url('') + '#contact'}>Contacter le prof</a></p>
    </div>
  </section>
</Base>
